# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin (local JSON auth)
ADMIN_EMAIL=admin@yogiplate.com
ADMIN_PASSWORD=yogiplate-admin
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# Supabase (optional — app runs on local .data JSON store without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (optional — demo checkout fulfills instantly without these)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend invoices (optional — invoices are stored even if email is skipped)
RESEND_API_KEY=
INVOICE_FROM_EMAIL=Yogiplate <orders@yourdomain.com>

# Google Distance Matrix (optional — falls back to Bay Area city haversine)
GOOGLE_MAPS_API_KEY=

# Kitchen default (also editable in Admin → Settings)
KITCHEN_ADDRESS=Fremont, CA 94538

# Corporate inquiry SMTP (Private Email / Namecheap — same as Stone Craft)
# From address customers never see recipients for; Reply-To is the requester.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=support@stonecraftpizza.us
SMTP_PASSWORD=
SMTP_FROM_NAME=Yogiplate Corporate Catering
# You + Radhavallabh (never returned to the browser)
CORPORATE_NOTIFY_EMAILS=raghuvmkc@gmail.com,rvdrns@gmail.com

# Gemini front-desk chat
GEMINI_API_KEY=
# Owner WhatsApp in E.164 digits only, e.g. 14085551234 (no + or spaces)
OWNER_WHATSAPP_E164=
NEXT_PUBLIC_OWNER_WHATSAPP_E164=
