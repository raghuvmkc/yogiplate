# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin (local JSON auth)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Supabase (optional — app runs on local .data JSON store without these)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (optional — demo checkout fulfills instantly without these)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Resend invoices (optional — invoices are stored even if email is skipped)
RESEND_API_KEY=
INVOICE_FROM_EMAIL=Yogiplate <orders@yourdomain.com>

# Google Distance Matrix (optional — falls back to Bay Area city haversine)
GOOGLE_MAPS_API_KEY=

# Kitchen default (also editable in Admin → Settings)
KITCHEN_ADDRESS=Fremont, CA 94538

# Corporate inquiry SMTP (Private Email / Namecheap — same as Stone Craft)
# From address customers never see recipients for; Reply-To is the requester.
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=support@stonecraftpizza.us
SMTP_PASSWORD=
SMTP_FROM_NAME=Yogiplate Corporate Catering
# You + Radhavallabh (never returned to the browser)
CORPORATE_NOTIFY_EMAILS=raghuvmkc@gmail.com,rvdrns@gmail.com
# AI Yogi chat-end summary (Stone Craft SMTP — never returned to the browser)
CHAT_SUMMARY_NOTIFY_EMAILS=raghuvmkc@gmail.com

# People names used by AI Yogi (single source — agent copy reads these)
CHEF_FOUNDER_NAME=Radhavallabh
CHEF_FOUNDER_TITLE=Chef and Founder
CHEF_FOUNDER_PREFIX=Mr.
MANAGER_NAME=Raghu
MANAGER_TITLE=Restaurant Manager

# Manager / chef notify when guest asks for a person (email + SMS).
# Catering quotation emails also Cc this list (Chef Radhavallabh and Manager Raghu).
MANAGER_NOTIFY_EMAILS=raghuvmkc@gmail.com,rvdrns@gmail.com
MANAGER_NOTIFY_PHONES=+16692788417,+14079688422

# Twilio SMS (same as Stone Craft Pizza) — quote texts + manager handoff texts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Browser phone on /admin/desk. API key is an SK... sid from Twilio, not the account auth token.
# TwiML App voice URL: https://<live-site>/api/voice/twiml/outgoing
# Stone Craft number "A call comes in": https://<live-site>/api/voice/twiml/incoming
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=

# Gemini front-desk chat
GEMINI_API_KEY=
# Owner WhatsApp in E.164 digits only, e.g. 14085551234 (no + or spaces)
# Chat transfer UI is disabled in code until WHATSAPP_CHAT_TRANSFER_ENABLED is set true in agent.ts
OWNER_WHATSAPP_E164=
NEXT_PUBLIC_OWNER_WHATSAPP_E164=

# Sarvam AI speech-to-text for AI Yogi calls — https://docs.sarvam.ai
# Copy from VoiceWebBuilder .env or dashboard → API subscription key
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3

# Text-to-speech. TTS_PROVIDER is sarvam or google.
# TTS_VOICE must match the provider:
#   Google (Gemini TTS, uses GEMINI_API_KEY): Kore, Aoede, Charon
#   Sarvam (bulbul:v3): priya, neha, rahul
TTS_PROVIDER=sarvam
TTS_VOICE=priya
# Optional. Only used when TTS_PROVIDER=google.
GOOGLE_TTS_MODEL=gemini-2.5-flash-preview-tts
