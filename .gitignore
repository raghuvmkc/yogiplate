# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# generated Netlify-ready copy (recreate with: npm run pack-deploy)
/deploy/yogiplate-site/

# legacy / local-only (not needed for Netlify deploy)
/YogiplateKT/
/YogiplateKT.zip
/Images/
/_Images_local_backup/
/AllYogiplatePreviousOrders.txt
/.cursor/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local JSON store
.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
